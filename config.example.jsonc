{
  // ── Lighting console (the desk we fail over from) ─────────────────────────
  "console": {
    "ip": "10.10.20.10",        // desk's IP — also the source filter for recording
    "timeoutMs": 1000,          // silence before the desk is considered "lost"
    "defaultScene": "1",        // scene to recall on handoff if nothing else is on
    "defaultFade": 3            // crossfade seconds on console handoff / startup
  },

  // ── Art-Net / DMX network ────────────────────────────────────────────────
  "artnet": {
    "port": 6454,               // we listen here (desk + ArtPoll) and send to nodes by default
    "localIp": "",              // IP advertised in ArtPollReply; blank = auto-detect
    "universes": 6,             // universe count (valid numbers 0..universes-1)
    "channels": 512,            // DMX channels per universe
    // Nodes we drive on failover ("port" optional). "ip" is, in order of preference:
    //   the node's own IP      — only that node receives the traffic
    //   its subnet broadcast   — e.g. "169.254.255.255" for a node that self-assigns
    //                            169.254.x.x (Botex DPX NET); needs a 169.254 address here
    //   "" or 255.255.255.255  — every device on the network receives it
    // Universe = Art-Net Port-Address: Subnet 0/Universe 1 → 1, Subnet 1/Universe 0 → 16.
    "outputs": [
      { "name": "Chauvet Net-X II", "ip": "10.10.20.1", "port": 6454, "universes": [2, 3, 4, 5] },
      { "name": "Botex Dimmer",     "ip": "169.254.255.255", "port": 6454, "universes": [0] }
    ]
  },

  // ── Companion / OSC control surface ──────────────────────────────────────
  "companion": {
    "listenPort": 9000,         // we listen here for OSC commands (Companion "send" target)
    "feedbackTargets": [        // where we push /scene-setter/* feedback
      { "ip": "10.10.20.50", "port": 9001 }
    ],
    "customVariables": {        // optionally set Companion custom variables via its OSC API
      "enabled": false,
      "ip": "10.10.20.50",
      "port": 12321,            // Companion's OSC listener
      "prefix": "house_"
    }
  },

  // ── Web UI / API ─────────────────────────────────────────────────────────
  "web": {
    "port": 8080              // control-panel UI (HTTP + WebSocket)
  },

  // ── Engine timing (rarely changed) ───────────────────────────────────────
  "timing": {
    "fadeFrameMs": 40,
    "keepAliveMs": 1000,
    "startupGraceMs": 1500,
    "feedbackHeartbeatMs": 5000
  },

  "dataDir": "./data"
}
