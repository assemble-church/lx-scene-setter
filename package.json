{
  "name": "lx-scene-setter",
  "version": "1.0.0",
  "description": "Light It: house lighting scenes, sequences and Art-Net desk failover, controlled from the web UI or Companion.",
  "main": "src/index.js",
  "bin": {
    "scene-setter": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -n engine,ui -c blue,magenta \"npm:dev:engine\" \"npm:dev:ui\"",
    "dev:engine": "node --watch src/index.js",
    "dev:ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "build": "npm --prefix ui install && npm --prefix ui run build && npm run companion:build",
    "test": "node test/sequence-analyse.test.js && node test/sequence-engine.test.js",
    "companion:build": "node scripts/build-companion.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fast-xml-parser": "^5.9.3",
    "osc": "^2.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "license": "MIT"
}
